# Copy this file to .env.local for local development.
# Never commit real secrets.

# Convex client configuration
VITE_CONVEX_URL=https://your-convex-url.convex.cloud
CONVEX_DEPLOYMENT=your-convex-deployment-name

# App runtime / auth settings
SITE_URL=http://localhost:5173
CONVEX_SITE_URL=http://localhost:3210
JWKS={"keys":[{"kty":"EC","d":"YOUR_KEY","crv":"P-256","kid":"dev","k":"YOUR_KEY","alg":"ES256"}]}
JWT_PRIVATE_KEY=replace-with-your-private-key
DOTENV_PRIVATE_KEY_LOCAL=replace-with-your-dotenv-private-key

# Email + analytics
VLY_EMAIL_API_KEY=replace-with-your-email-api-key
VITE_PLAUSIBLE_DOMAIN=shiftedtone.com
VITE_PLAUSIBLE_API_HOST=https://plausible.io
